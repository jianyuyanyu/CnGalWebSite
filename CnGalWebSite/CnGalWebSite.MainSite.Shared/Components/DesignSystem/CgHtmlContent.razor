@* CgHtmlContent — 通用 HTML 内容显示组件，用于渲染 markdown 解析生成的 HTML *@

@if (!string.IsNullOrWhiteSpace(Content))
{
    <div class="cg-html-content">
        @(new MarkupString(Content))
    </div>
}

@code {
    /// <summary>
    /// 已由服务端完成净化的 HTML；此组件不接受原始用户输入。
    /// </summary>
    [Parameter]
    public string? Content { get; set; }

}
